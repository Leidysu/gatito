class Libro:
    def __init__(self, titulo, autor, categoria, isbn):
        self.titulo = titulo
        self.autor = autor
        self.categoria = categoria
        self.isbn = isbn

    def __repr__(self):
        return f"Libro({self.titulo}, {self.autor}, {self.categoria}, {self.isbn})"


class Usuario:
    def __init__(self, nombre, id_usuario):
        self.nombre = nombre
        self.id_usuario = id_usuario
        self.libros_prestados = []

    def __repr__(self):
        return f"Usuario({self.nombre}, {self.id_usuario})"

    def prestar_libro(self, libro):
        self.libros_prestados.append(libro)

    def devolver_libro(self, libro):
        if libro in self.libros_prestados:
            self.libros_prestados.remove(libro)


class Biblioteca:
    def __init__(self):
        self.libros = {}
        self.usuarios = {}

    def anadir_libro(self, libro):
        self.libros[libro.isbn] = libro

    def quitar_libro(self, isbn):
        if isbn in self.libros:
            del self.libros[isbn]

    def registrar_usuario(self, usuario):
        self.usuarios[usuario.id_usuario] = usuario

    def eliminar_usuario(self, id_usuario):
        self.usuarios.pop(id_usuario, None)

    def prestar_libro(self, id_usuario, isbn):
        usuario = self.usuarios.get(id_usuario)
        libro = self.libros.get(isbn)
        if usuario and libro:
            usuario.prestar_libro(libro)
            self.quitar_libro(isbn)
            return f"Libro '{libro.titulo}' prestado a {usuario.nombre}"
        return "Usuario o libro no encontrado."

    def devolver_libro(self, id_usuario, isbn):
        usuario = self.usuarios.get(id_usuario)
        libro = next((l for l in usuario.libros_prestados if l.isbn == isbn), None) if usuario else None
        if usuario and libro:
            usuario.devolver_libro(libro)
            self.anadir_libro(libro)
            return f"Libro '{libro.titulo}' devuelto por {usuario.nombre}"
        return "Libro no encontrado en los préstamos de este usuario."

    def buscar_libro(self, criterio, valor):
        resultados = []
        if criterio == "titulo":
            resultados = [libro for libro in self.libros.values() if valor.lower() in libro.titulo.lower()]
        elif criterio == "autor":
            resultados = [libro for libro in self.libros.values() if valor.lower() in libro.autor.lower()]
        elif criterio == "categoria":
            resultados = [libro for libro in self.libros.values() if valor.lower() in libro.categoria.lower()]
        return resultados

    def listar_libros_prestados(self, id_usuario):
        usuario = self.usuarios.get(id_usuario)
        if usuario:
            return usuario.libros_prestados
        return []

# Ejemplo de uso
biblioteca = Biblioteca()

# Crear libros con nombres reales
libro1 = Libro("Cien años de soledad", "Gabriel García Márquez", "Novela", "123456")
libro2 = Libro("1984", "George Orwell", "Distopía", "789101")
libro3 = Libro("El Gran Gatsby", "F. Scott Fitzgerald", "Ficción", "112233")
libro4 = Libro("Orgullo y prejuicio", "Jane Austen", "Romántico", "445566")

# Añadir libros a la biblioteca
biblioteca.anadir_libro(libro1)
biblioteca.anadir_libro(libro2)
biblioteca.anadir_libro(libro3)
biblioteca.anadir_libro(libro4)

# Crear usuarios
usuario1 = Usuario("Juan Pérez", 1)
usuario2 = Usuario("María Gómez", 2)

# Registrar usuarios en la biblioteca
biblioteca.registrar_usuario(usuario1)
biblioteca.registrar_usuario(usuario2)

# Prestar libros
print(biblioteca.prestar_libro(1, "123456"))  # Juan Pérez pide "Cien años de soledad"
print(biblioteca.prestar_libro(2, "789101"))  # María Gómez pide "1984"

# Listar libros prestados a Juan Pérez
print("Libros prestados a Juan Pérez:", biblioteca.listar_libros_prestados(1))

# Devolver libros
print(biblioteca.devolver_libro(1, "123456"))  # Juan Pérez devuelve "Cien años de soledad"

# Buscar libros por título
print("Buscar libro por título '1984':", biblioteca.buscar_libro("titulo", "1984"))

# Buscar libros por autor
print("Buscar libros de autor 'George Orwell':", biblioteca.buscar_libro("autor", "George Orwell"))
